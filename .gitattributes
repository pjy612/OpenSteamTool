# Default: normalize line endings to LF in repo, leave working tree as-is
* text=auto eol=crlf

# Windows scripts must keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files
*.dll     binary
*.exe     binary
*.lib     binary
*.pdb     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.zip     binary
